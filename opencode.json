{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek-local/default",
  "small_model": "deepseek-local/default",
  "provider": {
    "deepseek-local": {
      "name": "DeepSeek local web backend",
      "api": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:8787/v1",
        "apiKey": "local"
      },
      "models": {
        "default": {
          "name": "DeepSeek v4 Flash",
          "reasoning": true,
          "tool_call": true,
          "limit": {"context": 128000, "output": 8192}
        },
        "extra": {
          "name": "DeepSeek v4 Pro",
          "reasoning": true,
          "tool_call": true,
          "limit": {"context": 128000, "output": 8192}
        }
      }
    }
  }
}
